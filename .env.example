# Copy this file to .env and fill in the values.
# Never commit .env. The binaries auto-load .env if present (shell env wins).

# OpenAI-compatible LLM provider configuration.
SAKSAMA_MODEL=
SAKSAMA_API_BASE=
SAKSAMA_API_KEY=

# Optional: USD price per 1 MILLION tokens.
# Used only for cost metrics.
# Leave empty to report cost as 0.
SAKSAMA_PRICE_IN=
SAKSAMA_PRICE_OUT=
