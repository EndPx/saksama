# Copy this file to .env and fill in the values. Never commit .env.
# The model name is configured here, not hardcoded anywhere in the code.

SAKSAMA_MODEL=
SAKSAMA_API_BASE=
SAKSAMA_API_KEY=

# Optional: USD price per MILLION tokens, used only to compute the cost metric.
# Leave empty to report cost as 0.
SAKSAMA_PRICE_IN=
SAKSAMA_PRICE_OUT=
